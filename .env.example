# Supabase public client
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional compatibility if this repo shares envs with Next.js projects.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase server-only key. Never expose this in React.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google OAuth
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Mercado Pago Checkout Pro
VITE_MERCADOPAGO_PUBLIC_KEY=your-mercadopago-public-key
MERCADOPAGO_ACCESS_TOKEN=your-mercadopago-access-token
MERCADOPAGO_WEBHOOK_SECRET=your-webhook-secret
MERCADOPAGO_TEST_MODE=true
MERCADOPAGO_TEST_PAYER_EMAIL=test@testuser.com
MERCADOPAGO_TEST_CLIENT_ID=optional-auth-user-uuid-for-local-qa
MERCADOPAGO_TEST_PRODUCT_ID=optional-legacy-product-uuid-for-local-qa
MERCADOPAGO_LEGACY_SCHEMA_TEST_MODE=false
VITE_CHECKOUT_TEST_MODE=true
CHECKOUT_SITE_URL=https://your-site.example
ORDER_CONFIRMATION_RECIPIENT=orders@example.com

# R2 Cloudflare media proxy
R2_TOKEN_VALUE=your-cloudflare-api-token
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=your-r2-bucket-name
MULTIMEDIA_UPLOAD_PREFIX=images/meal-preps
MULTIMEDIA_MAX_UPLOAD_BYTES=8388608
