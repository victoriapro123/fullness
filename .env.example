# Supabase public client
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional compatibility if this repo shares envs with Next.js projects.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase server-only key. Never expose this in React.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Core360 Commerce. Keep the token only in a private server environment file.
CORE360_BASE_URL=https://core.prof3sional.com
CORE360_COMMERCE_TOKEN=your-revocable-core360-token
CORE360_COMMERCE_READ_ENABLED=false
CORE360_COMMERCE_POLL_ENABLED=false
CORE360_COMMERCE_PREVIEW_ENABLED=false
CORE360_COMMERCE_MEDIA_PROXY_ENABLED=false
CORE360_COMMERCE_MEDIA_WRITE_ENABLED=false
CORE360_COMMERCE_SYNC_ENABLED=false
CORE360_COMMERCE_DELIVERY_ENABLED=false
# Corte inclusivo y persistente del worker: no se encolan ni recuperan pagos anteriores.
# Obligatorio cuando SYNC/DISPATCH estén activos; usar una fecha ISO UTC aprobada en el cutover.
CORE360_COMMERCE_SYNC_FROM=
# Reintentos automáticos del outbox antes de dejar el evento en failed (1 a 20).
CORE360_COMMERCE_MAX_DELIVERY_ATTEMPTS=8
# Tope HTTP acotado por intento (1000 a 30000 ms); evita que un checkout quede esperando Core360.
CORE360_COMMERCE_REQUEST_TIMEOUT_MS=8000
# anonymous omite partnerId. identified crea/vincula mediante POST /customers y persiste el UUID Core360.
CORE360_COMMERCE_CUSTOMER_MODE=anonymous
# Sólo QA local aislado: autoriza HTTP exclusivamente en 127.0.0.1, ::1 o localhost.
CORE360_COMMERCE_TEST_MODE=false
# No configurar a mano: CORE360_PARTNER_ID no autoriza una orden y el adaptador la rechaza.
CORE360_PARTNER_ID=
# Protege POST /api/internal/core360/recover.
CORE360_RECOVERY_TOKEN=
# Protege la invocación GET del cron privado de recuperación; no habilita flags Core360.
CRON_SECRET=
CORE360_PRICE_LIST_ID=
CORE360_FISCAL_INTENT=pending

# Google OAuth
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GA_MEASUREMENT_ID=
VITE_GOOGLE_SITE_VERIFICATION=

# Mercado Pago Checkout Pro
VITE_MERCADOPAGO_PUBLIC_KEY=your-mercadopago-public-key
MERCADOPAGO_ACCESS_TOKEN=your-mercadopago-access-token
MERCADOPAGO_WEBHOOK_SECRET=your-webhook-secret
MERCADOPAGO_TEST_MODE=true
MERCADOPAGO_TEST_PAYER_EMAIL=test@testuser.com
MERCADOPAGO_TEST_CLIENT_ID=optional-auth-user-uuid-for-local-qa
MERCADOPAGO_TEST_PRODUCT_ID=optional-legacy-product-uuid-for-local-qa
MERCADOPAGO_LEGACY_SCHEMA_TEST_MODE=false
VITE_CHECKOUT_TEST_MODE=true
CHECKOUT_SITE_URL=https://your-site.example
ORDER_CONFIRMATION_RECIPIENT=orders@example.com
ORDER_NOTIFICATION_RECIPIENT=cecilia@fullnesslab.com
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Fullness Lab <cecilia@fullnesslab.com>
EMAIL_REPLY_TO=cecilia@fullnesslab.com
SITE_URL=https://www.fullnesslab.com
EMAIL_LOGO_URL=https://pub-16818329ca464c2e9bff6605b2f520f4.r2.dev/assets/brand/fullness-lab-horizontal-contrast-2026.png
EMAIL_TEST_RECIPIENT=test-recipient@example.com

# R2 Cloudflare media proxy
R2_TOKEN_VALUE=your-cloudflare-api-token
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=your-r2-bucket-name
MULTIMEDIA_UPLOAD_PREFIX=images/meal-preps
MULTIMEDIA_MAX_UPLOAD_BYTES=8388608
