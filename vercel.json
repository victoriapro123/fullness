{
  "crons": [
    {
      "path": "/api/internal/core360/recover",
      "schedule": "0 4 * * *"
    }
  ],
  "rewrites": [
    {"source":"/carrito","destination":"/index.html"},
    {"source":"/carrito/","destination":"/index.html"},
    {"source":"/checkout","destination":"/index.html"},
    {"source":"/checkout/","destination":"/index.html"},
    {"source":"/producto","destination":"/index.html"},
    {"source":"/carta","destination":"/index.html"},
    {"source":"/carta/","destination":"/index.html"},
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    },
    {
      "source": "/tienda",
      "destination": "/index.html"
    },
    {
      "source": "/tienda/",
      "destination": "/index.html"
    },
    {
      "source": "/comunidad",
      "destination": "/index.html"
    },
    {
      "source": "/comunidad/",
      "destination": "/index.html"
    },
    {
      "source": "/quienes-somos",
      "destination": "/index.html"
    },
    {
      "source": "/quienes-somos/",
      "destination": "/index.html"
    },
    {
      "source": "/preguntas-frecuentes",
      "destination": "/index.html"
    },
    {
      "source": "/preguntas-frecuentes/",
      "destination": "/index.html"
    },
    {
      "source": "/producto/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/producto/:slug/",
      "destination": "/index.html"
    }
  ]
}
